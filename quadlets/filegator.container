[Container]
Image=docker.io/filegator/filegator:latest-multiarch
ContainerName=filegator
AutoUpdate=registry
#Notify=true
LogDriver=journald
PublishPort=8082:8080
Volume=/home/suserunpi/config/filegator/configuration.php:/var/www/filegator/configuration.php
Volume=/home/suserunpi/config/filegator/php.ini-production:/usr/local/etc/php/php.ini
Volume=/mnt/octopus_media/videos:/var/www/filegator/repository:z
Network=caddynet.network
# Environment=DEFAULT_THEME=auto # light, dark, auto
# Environment='OUTPUT_TEMPLATE=%(title)s.%(ext)s'
# Environment='YTDL_OPTIONS=optionsforytdlinJSONformat'
# Environment=YTDL_OPTIONS_FILE=ytdl_options.json

[Service]
Restart=always

[Install]
WantedBy=default.target

[Unit]
After=network-online.target

